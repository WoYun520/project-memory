{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Memory worklog v0.1",
  "type": "object",
  "properties": {
    "format": {
      "const": "project-memory-worklog"
    },
    "version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "actor": {
          "type": "object",
          "description": "Optional declared recorder identity. Existing worklogs without this field retain their original bytes and legacy agent attribution. Never use this declaration as user confirmation or authenticated identity.",
          "properties": {
            "kind": {
              "enum": [
                "agent",
                "tool"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        "handoff_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "description": "Exact handoff ticket from this task. Optional claim, never inferred from the latest project task."
        }
      },
      "required": [
        "id",
        "agent"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "kind": {
            "enum": [
              "goal",
              "fact",
              "decision",
              "attempt",
              "constraint",
              "state",
              "task"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "origin": {
            "enum": [
              "human_statement",
              "observation",
              "inference"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "speaker": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "human",
                      "agent",
                      "tool"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "redacted": {
                "type": "boolean"
              },
              "file": {
                "type": "object",
                "description": "A submitted file-source declaration, not proof of authenticated tool access. Use only project-relative paths; never include local absolute directories or private metadata.",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240,
                    "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.)(?!.*\\/$)[^\\\\:\\u0000-\\u001f]+$"
                  },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "selector": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "path",
                  "content_sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "speaker",
              "text"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "outcome": {
            "enum": [
              "unknown",
              "failed",
              "partial",
              "succeeded"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "stage": {
            "enum": [
              "not_started",
              "in_progress",
              "blocked",
              "awaiting_validation",
              "completed",
              "cancelled"
            ]
          },
          "mistake": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "check_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "correction_entry_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
          },
          "file_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.)(?!.*\\/$)[^\\\\:\\u0000-\\u001f]+$"
            }
          },
          "file_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "speaker": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "human",
                            "agent",
                            "tool"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "redacted": {
                      "type": "boolean"
                    },
                    "file": {
                      "type": "object",
                      "description": "A submitted file-source declaration, not proof of authenticated tool access. Use only project-relative paths; never include local absolute directories or private metadata.",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240,
                          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.)(?!.*\\/$)[^\\\\:\\u0000-\\u001f]+$"
                        },
                        "content_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "selector": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "path",
                        "content_sha256"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "speaker",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "required": [
                    "file"
                  ]
                }
              ]
            }
          },
          "file_notes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "update": {
            "type": "object",
            "properties": {
              "memory_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              },
              "base_revision": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "memory_id",
              "base_revision",
              "reason"
            ],
            "additionalProperties": false
          },
          "applicability": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "unknown",
                  "task",
                  "project"
                ]
              },
              "task": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "task_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "task"
                    }
                  }
                },
                "then": {
                  "required": [
                    "task"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "task"
                        ]
                      },
                      {
                        "required": [
                          "task_id"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "completion": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "stage": {
                "enum": [
                  "completed",
                  "in_progress"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "task_id",
              "stage",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "detail",
          "origin",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "attempt"
                }
              }
            },
            "then": {
              "required": [
                "conditions",
                "result",
                "outcome"
              ]
            }
          },
          {
            "if": {
              "required": [
                "correction_entry_id"
              ]
            },
            "then": {
              "required": [
                "mistake"
              ],
              "properties": {
                "kind": {
                  "const": "attempt"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "task_id"
              ]
            },
            "then": {
              "required": [
                "stage"
              ],
              "properties": {
                "kind": {
                  "const": "state"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "version",
    "project_id",
    "session",
    "entries"
  ],
  "additionalProperties": false
}
